{
  "name": "semd-chrome-extension",
  "version": "1.0.0",
  "description": "SEMD - Suspicious URL Evaluation for Malicious Detection Chrome Extension",
  "private": true,
  "scripts": {
    "dev": "bunx next dev",
    "build:popup": "bunx next build",
    "build:chrome": "bun scripts/build-extension.ts chrome",
    "build:firefox": "bun scripts/build-extension.ts firefox",
    "build": "bun run build:chrome && bun run build:firefox",
    "build:all": "bun run build",
    "package:chrome": "bun scripts/build-extension.ts chrome --package",
    "package:firefox": "bun scripts/build-extension.ts firefox --package",
    "start": "bunx next start",
    "lint": "bunx next lint",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf .next dist out export/semd-chrome.zip export/semd-addon.xpi export/semd-addon.zip"
  },
  "dependencies": {
    "@types/chrome": "^0.0.254",
    "next": "^14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "archiver": "^6.0.0",
    "autoprefixer": "^10.4.16",
    "cpx": "^1.5.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "js-yaml": "^4.1.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.0.0"
  }
}
