{
  "name": "semd-extension",
  "version": "1.0.0",
  "description": "SEMD - Suspicious URL Evaluation for Malicious Detection Browser Extension",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:chrome": "npx tsx scripts/build-chrome.ts",
    "build:firefox": "npx tsx scripts/build-firefox.ts",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "build:legacy": "node scripts/build-extension.js",
    "start": "next start",
    "lint": "next lint",
    "clean": "rm -rf out .next",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^14.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.0",
    "@types/chrome": "^0.0.254",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "archiver": "^6.0.0",
    "autoprefixer": "^10.4.16",
    "esbuild": "^0.20.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  }
}
